<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Os testes usam um banco MySQL SEPARADO (biko_testing), que é
            apagado e recriado a cada execução. Host, usuário e senha vêm do
            seu .env; só o nome do banco é trocado aqui. O tests/CreatesApplication.php
            se recusa a rodar se o banco não terminar em "_testing".
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:mDPrIYjTzH/YxFrur4NF/vobpaX4X+QeXh/ZzQCbZjU="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="biko_testing"/>
        <env name="BROADCAST_DRIVER" value="log"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="HCAPTCHA_SECRET" value=""/>
    </php>
</phpunit>
